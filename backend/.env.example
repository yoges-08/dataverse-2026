# Cloud Database (MongoDB Atlas). Without this, the server falls back to a
# local file (backend/data/db.json) which DOES NOT persist on Render/Vercel.
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/dataverse_symposium
JWT_SECRET=dataverse_secret_key_2026
PORT=5000

# Optional: comma-separated list of allowed frontend origins (the deployed
# Vercel URL). If left empty, all origins are allowed (fine for now).
CORS_ORIGINS=

# SMTP for emailing registrations (symposium code + QR ticket)
# Leave blank to run in DEV MODE (emails are logged to the console, not sent)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-email@example.com
SMTP_PASS=your-app-password
SMTP_FROM="DATAVERSE 2026"
