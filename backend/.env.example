# Cloud Database (MongoDB Atlas). Without this, the server falls back to a
# local file (backend/data/db.json) which DOES NOT persist on Render/Vercel.
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/dataverse_symposium

# REQUIRED. Used to sign/verify JWT tokens. The server now refuses to start
# without it (no more hardcoded fallback secret). Use a long random string.
JWT_SECRET=<your-long-random-secret>
PORT=5000

# Comma-separated list of allowed frontend origins (e.g. the deployed frontend
# URL). Recommended for production. If left empty the API stays open to all
# origins (dev-friendly, less secure).
CORS_ORIGINS=

# Passwords seeded for the Super Admin / Coordinator / Volunteer accounts.
# Only used by `npm run seed`. REQUIRED if you run the seed script.
ADMIN_SEED_PASSWORD=<your-admin-password>
COORDINATOR_SEED_PASSWORD=<your-coordinator-password>
VOLUNTEER_SEED_PASSWORD=<your-volunteer-password>

# Set to "true" ONLY for local development to return the password-reset OTP in
# the API response. NEVER true in production (that would leak OTPs).
SHOW_DEV_OTP=false

# Email sending via Brevo API (port 443) - reliable from cloud servers.
# REQUIRED for real emails on Render. Generate at Brevo -> SMTP & API -> API Keys.
BREVO_API_KEY=<your-brevo-api-key>

# Verified Brevo sender email. No SMTP credentials are used anywhere.
# SMTP_HOST / SMTP_USER / SMTP_PASS must NOT be set - the app never logs into
# an email account (that is what caused the Gmail account disabling).
SMTP_FROM=<your-verified-brevo-sender@example.com>

# Optional AI Fallback for College Name Matching (Teammate Management)
# When set, unresolvable non-standard college variants are evaluated using Claude
# and cached in MongoDB. When blank, system runs purely deterministic (free, zero errors).
ANTHROPIC_API_KEY=